# Host port mapping for the local stack.
#
# The canonical ports (3000/3100/3200/4317/4318/9090) are the compose defaults, but
# they collide with any other Grafana/Tempo/Prometheus stack already running on this
# machine. This file shifts them into a free block. Delete it to use the defaults.
# Interface the ports publish on. 0.0.0.0 = reachable from other machines;
# 127.0.0.1 = this host only. Grafana here allows anonymous viewers.
BIND_HOST=0.0.0.0
# The address others reach Grafana on; used for its share/alert links.
GRAFANA_ROOT_URL=http://192.168.88.102:3010/

APP_PORT=7072
# Only used by the `two-services` profile.
SERVICE_A_PORT=7080
SERVICE_B_PORT=7081
GRAFANA_PORT=3010
LOKI_PORT=3110
TEMPO_PORT=3210
TEMPO_OTLP_GRPC_PORT=4327
TEMPO_OTLP_HTTP_PORT=4328
TEMPO_JAEGER_COMPACT_PORT=6841
PROMETHEUS_PORT=9092
ALLOY_PORT=12345

# Paste a Sentry DSN here to send errors from the stack; empty = Sentry off.
SENTRY_DSN=

SERVICE_NAME=wan
SERVICE_VERSION=0.2.0

# Sentry datasource in Grafana (read side; SENTRY_DSN above is the write side).
# Self-hosted Sentry on this machine: http://host.docker.internal:<port>
# Two different addresses for the same Sentry, on purpose:
#   SENTRY_GRAFANA_URL  what the Grafana *container* dials for the datasource.
#   SENTRY_PUBLIC_URL   what a *browser* opens, used to build the issue links.
SENTRY_GRAFANA_URL=http://host.docker.internal:9090
SENTRY_PUBLIC_URL=http://localhost:9090
SENTRY_ORG_SLUG=bettersentryio

# SENTRY_AUTH_TOKEN is deliberately NOT here: this file is tracked, and a token pasted
# into it gets committed. Export it instead, in the shell that runs docker compose:
#
#     export SENTRY_AUTH_TOKEN=...
#     make restart-grafana
#
# It is not the DSN -- create one in Sentry with project:read and event:read.
